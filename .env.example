OPENAI_BASE_URL=https://your-compatible-provider.example/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=cx/gpt-5.6-sol
OPENAI_REASONING_EFFORT=max
OPENAI_RESPONSE_FORMAT=json_schema
VIDEO_WORKER_CONCURRENCY=2
TTS_VOICE=af_heart
TTS_SPEED=0.94
VIDEO_RENDER_FPS=15
VIDEO_RENDER_WIDTH=960
VIDEO_RENDER_HEIGHT=540
# Optional if Blender or model files are installed elsewhere:
# BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender
# TTS_MODEL_PATH=/absolute/path/to/kokoro-v1.0.onnx
# TTS_VOICES_PATH=/absolute/path/to/voices-v1.0.bin
